# Container hostname used by shells and hostname-based environment labels.
WORKSPACE_HOSTNAME=agent-container
# Host interface to publish on. Loopback keeps access local by default.
T3_BIND_ADDRESS=127.0.0.1
T3_PORT=3773
# HTTP(S) origin reachable from the client, including a non-default port.
T3_PUBLIC_URL=http://localhost:3773
# Configuration dashboard. Its login is separate from T3 pairing.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3780
# Set the exact public origin when using an HTTPS reverse proxy.
# DASHBOARD_PUBLIC_URL=https://box.example.com
# Optional build-cache refresh for the floating nightly seed.
# T3_REFRESH=rebuild-1
# Published images (no local build), optionally combined with Sysbox:
# COMPOSE_FILE=compose.yaml:compose.images.yaml:compose.sysbox.yaml
# WORKSPACE_IMAGE=ghcr.io/zzackllack/agent-container:latest
# DASHBOARD_IMAGE=ghcr.io/zzackllack/agent-container-dashboard:latest
# On a Linux host with Sysbox, uncomment to enable the nested Docker override.
# COMPOSE_FILE=compose.yaml:compose.sysbox.yaml
# Ubuntu browser sandbox: load the host policy first; see docs/browser.md.
# COMPOSE_FILE=compose.yaml:compose.sysbox.yaml:compose.browser.yaml
# Sysbox cannot run Chrome's sandbox; this override disables it. Read
# docs/browser.md first, then combine with the overrides above.
# COMPOSE_FILE=compose.yaml:compose.sysbox.yaml:compose.browser-unsandboxed.yaml
