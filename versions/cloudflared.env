# cloudflared is pinned to a GitHub release asset, not the apt repository.
# Cloudflare's apt index carries a single version per architecture, so an exact
# apt pin silently became uninstallable when 2026.10.1 left the index (the
# nightly image build failed with "Version '2026.10.1' ... was not found").
# Release assets are immutable, so the pin stays resolvable.
# Update the version and both checksums together from
# https://github.com/cloudflare/cloudflared/releases and verify with
# `sha256sum cloudflared-linux-{amd64,arm64}.deb`.
CLOUDFLARED_VERSION=2026.10.7
CLOUDFLARED_SHA256_AMD64=70b1a1e0f46033ffc8d90b406e554044ba6cbf2e4360295ef1163aed31e09393
CLOUDFLARED_SHA256_ARM64=d9407eb6e70ac31f54978a6b408a0320b51b664a6d0b498248692d7ac56bf836
