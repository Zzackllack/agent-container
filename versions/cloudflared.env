# Cloudflare cloudflared comes from Cloudflare's signed Debian repository
# (pkg.cloudflare.com). The repository key is checksum-pinned here and the
# package version is pinned exactly, so a rebuild installs the same release.
# The repository's signed package index carries the SHA-256 of every .deb and
# apt verifies it during the install.
CLOUDFLARED_VERSION=2026.10.1
CLOUDFLARED_APT_KEY_SHA256=1bd95f4082b320d541bee351560fc2765aa9f9cd8efa4c9e32135e63f252721d
