# rustup-init comes from the immutable rustup archive, not the "stable" dist
# path: dist/<target>/rustup-init is republished with every rustup release, so a
# pinned checksum there fails as soon as upstream ships a new build (this broke
# the nightly image build when rustup 1.29.2 replaced the pinned binary). The
# archive path keeps the version and its checksum resolvable.
# Bump all three values together; the checksums for both targets are next to
# each installer as rustup-init.sha256.
RUSTUP_VERSION=1.29.3
RUST_TOOLCHAIN_VERSION=1.99.1
RUSTUP_SHA256_AMD64=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
RUSTUP_SHA256_ARM64=9f608c142e0e38a78957d0661ba1dfaf0b6fb37184cfaa4b9a0aa57af6184282
