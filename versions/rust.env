# rustup-init comes from the stable channel at static.rust-lang.org, which
# publishes a .sha256 next to each installer. The toolchain itself is pinned
# explicitly so an image rebuild cannot silently change rustc.
RUST_TOOLCHAIN_VERSION=1.99.1
RUSTUP_SHA256_AMD64=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
RUSTUP_SHA256_ARM64=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433
