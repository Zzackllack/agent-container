# Debian 13 ships OpenJDK 25, the current LTS. Its 25.0.4.1+1 package matches
# the Eclipse Temurin 25.0.4.1+1 release, so the signed distribution package is
# used instead of an upstream archive. Debian security updates move the patch
# version within the major; only the major is pinned here.
JAVA_MAJOR_VERSION=25
