# Apache Maven binary distribution from archive.apache.org. That mirror keeps
# every release, so the pin stays resolvable; dlcdn.apache.org only carries the
# current releases and would fail the nightly build as soon as 3.10.0 is
# superseded. The pinned SHA-512 is identical on both mirrors.
MAVEN_VERSION=3.10.0
MAVEN_SHA512=908b1501bfb420bf7c8affb855534a9c407fd6099367bfb9f2f2dcb8e9799102bffb84518cde74c679bd76870247c6528683abdd620581bffa90f95d92d175aa
